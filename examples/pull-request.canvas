<Stack gap="16">
  <h1>Payments timeout</h1>
  <Row gap="8" align="center" justify="space-between" wrap="true">
    <Row gap="8" align="center" justify="start" wrap="true">
      <Pill active="true" tone="neutral" size="md" onClick="filterDiff">Diff</Pill>
      <Pill active="false" tone="neutral" size="md" onClick="filterChecks">Checks</Pill>
      <Pill active="false" tone="neutral" size="sm" keyboardHint="C" title="Comment" onClick="comment">Comment</Pill>
    </Row>
    <DiffStats additions="12" deletions="4"/>
  </Row>
  <markdown>
    Branch `fix/payments-timeout` against main.
    See the [pull request](https://example.com/pr/4821).
  </markdown>
  <Card variant="default" size="base" collapsible="true" defaultOpen="true" open="true" onOpenChange="toggleFile">
    <CardHeader>
      src/payments/client.ts
      <trailing>
        <DiffStats additions="8" deletions="3"/>
      </trailing>
    </CardHeader>
    <CardBody>
      <DiffView path="src/payments/client.ts" language="typescript" showLineNumbers="true" coloredLineNumbers="true" showAccentStrip="true">
        <lines>
          <line type="unchanged" content="export async function charge(order) {" lineNumber="14"/>
          <line type="removed" content="  return client.post(order)" lineNumber="15"/>
          <line type="added" content="  const timeout = 1500" lineNumber="15"/>
          <line type="added" content="  return client.post(order, { timeout })" lineNumber="16"/>
          <line type="unchanged" content="}" lineNumber="17"/>
        </lines>
      </DiffView>
    </CardBody>
  </Card>
  <Card variant="borderless" size="base" collapsible="false">
    <CardHeader>src/payments/client.test.ts</CardHeader>
    <CardBody>
      <DiffView path="src/payments/client.test.ts" language="typescript" showLineNumbers="true" coloredLineNumbers="true" showAccentStrip="true">
        <lines>
          <line type="unchanged" content="test(&quot;charge respects timeout&quot;, async () => {" lineNumber="8"/>
          <line type="added" content="  expect(timeout).toBe(1500)" lineNumber="9"/>
        </lines>
      </DiffView>
    </CardBody>
  </Card>
  <h2>Review</h2>
  <TodoListCard defaultExpanded="true" onTodoClick="openItem">
    <todos>
      <todo id="timeout" content="Confirm the 1500ms budget with payments" status="completed"/>
      <todo id="retry" content="Check retry share after deploy" status="in_progress"/>
      <todo id="docs" content="Note the timeout in the runbook" status="pending"/>
    </todos>
  </TodoListCard>
  <textarea onChange="setComment" placeholder="Leave a review comment" rows="4"></textarea>
  <Row gap="8" align="center" justify="space-between" wrap="false">
    <select value="comment" onChange="setAction" placeholder="Choose an action">
      <option value="comment">Comment</option>
      <option value="approve">Approve</option>
      <option value="request">Request changes</option>
    </select>
    <button variant="primary" disabled="false" onClick="submit">Submit review</button>
  </Row>
</Stack>
